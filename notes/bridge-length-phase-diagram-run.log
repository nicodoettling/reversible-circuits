#!/usr/bin/env python3
"""Deterministic exact checks for Theorem D and its new survival lemma.

All new combinatorial and floor checks use integers/Fraction. Reported decimal
ratios are summaries of exact rational calculations. Finite checks are only
falsification attempts; report.md contains the completeness proof.
"""
from __future__ import annotations
from fractions import Fraction
from itertools import combinations, permutations, product
from math import comb, factorial, isqrt
from pathlib import Path
import hashlib
import json
import platform
import subprocess
import time

HERE = Path(__file__).resolve().parent
ROOT = HERE.parents[3]


def compose(a, b):
    return tuple(a[b[i]] for i in range(len(a)))


def inv(a):
    out = [0] * len(a)
    for i, x in enumerate(a):
        out[x] = i
    return tuple(out)


def trans(n, i, j):
    out = list(range(n))
    out[i], out[j] = out[j], out[i]
    return tuple(out)


def generators(n):
    return [trans(n, i, j) for i, j in combinations(range(n), 2)]


def endpoint_tables(n, gens, length):
    """Right multiplication in the displayed-word convention."""
    ps = list(permutations(range(n)))
    index = {p: j for j, p in enumerate(ps)}
    nxt = [[index[compose(p, t)] for t in gens] for p in ps]
    tables = [[0] * len(ps)]
    tables[0][index[tuple(range(n))]] = 1
    for _ in range(length):
        old = tables[-1]
        new = [0] * len(ps)
        for i, count in enumerate(old):
            if count:
                for j in nxt[i]:
                    new[j] += count
        tables.append(new)
    return ps, index, tables


def parity(p):
    return sum(p[i] > p[j] for i in range(len(p)) for j in range(i + 1, len(p))) % 2


def cycles(p):
    seen = set()
    out = 0
    for i in range(len(p)):
        if i not in seen:
            out += 1
            while i not in seen:
                seen.add(i)
                i = p[i]
    return out


def ceil_sqrt(n):
    a = isqrt(n)
    return a + (a*a != n)


def ceil_fraction(x):
    return -(-x.numerator // x.denominator)


def floors(n, q):
    cs = {5: Fraction(1)}
    bs = {4: 0, 5: 20*q}
    for r in range(6, n+1):
        cs[r] = cs[r-1] + Fraction(1, r*ceil_sqrt(r))
        bs[r] = ceil_fraction(q*r*(r-1)*cs[r])
    return cs, bs


def z(n, k, x):
    b = n-1
    return (b**k + b*(-1)**k)//n if x == n-1 else (b**k-(-1)**k)//n


def scalar_checks():
    cases = 0
    minimum_gap_ratio_squared = None
    selected = []
    ns = list(range(5, 65)) + [128, 256, 512, 1024]
    for n in ns:
        ell = (n-1).bit_length()
        for q in sorted({4*ell, 144, 1000}):
            if q < 4*ell:
                continue
            cs, bs = floors(n, q)
            assert bs[n] <= 2*q*n*(n-1)
            for r in range(5, n+1):
                assert 1 <= cs[r] < 2
                assert bs[r] >= q*r*(r-1)
                assert 2*bs[r] <= 4*q*r*r
                if r >= 6:
                    mu = Fraction(r-2, r)*bs[r]
                    gap = mu-bs[r-1]
                    raw = Fraction(q*(r-1)*(r-2), r*ceil_sqrt(r))-1
                    assert gap >= raw > 0
                    assert gap*gap >= Fraction(q*q*r, 16)
                    assert (r-1)*(r-2)*2 >= r*r
                    assert 4*ceil_sqrt(r)**2 <= 9*r
                    assert q*q*r >= 144
                    # Denominator bound uses sqrt(r)<=r/2.
                    assert 4*r <= r*r
                    assert Fraction(97, 12) <= 9
                    ratio_sq = gap*gap/Fraction(q*q*r, 16)
                    minimum_gap_ratio_squared = ratio_sq if minimum_gap_ratio_squared is None else min(minimum_gap_ratio_squared, ratio_sq)
                cases += 1
            if n in (6, 64, 1024) and q in (4*ell, 1000):
                selected.append({'N': n, 'q': q, 'B_N': bs[n], 'top_length': 2*q*n*(n-1)})
    return {'rank_floor_cases': cases, 'minimum_gap_over_claim_squared': float(minimum_gap_ratio_squared), 'selected': selected}


def small_word_checks():
    result = []
    total_words = 0
    for n, length in [(2,0),(2,2),(2,5),(3,4),(4,4),(4,6),(4,3)]:
        words_by_endpoint = {}
        edges = tuple(combinations(range(n), 2))
        for word in product(edges, repeat=m):
            words_by_endpoint.setdefault(evaluate(n, word), []).append(word)
        probabilities_checked = 0
        for endpoint, words in words_by_endpoint.items():
            dp = BridgeDP(n, m, endpoint)
            assert dp.count == len(words)
            assert evaluate(n, valid_word(n, m, endpoint)) == endpoint
            for word in words:
                assert dp.word_probability(word) == Fraction(1, len(words))
                probabilities_checked += 1
            for seed in results["seeds"]:
                assert evaluate(n, dp.sample(random.Random(seed))) == endpoint
        results["endpoint_checks"].append({"N": n, "m": m,
            "feasible_endpoints": len(words_by_endpoint),
            "all_word_probabilities_checked": probabilities_checked, "ok": True})
    for n in range(1, 6):
        for endpoint in permutations(range(n)):
            h = sum(defect_type(endpoint))
            for m in sorted(set([0, 1, 2, 3, h, h + 1, h + 2, h + 4])):
                if feasible(n, m, endpoint):
                    dp = BridgeDP(n, m, endpoint)
                    assert evaluate(n, valid_word(n, m, endpoint)) == endpoint
                    assert evaluate(n, dp.sample(random.Random(4103))) == endpoint
                else:
                    try:
                        BridgeDP(n, m, endpoint)
                    except ValueError:
                        pass
                    else:
                        raise AssertionError("accepted an empty fiber")
        results["boundary_checks"].append({"N": n, "all_endpoints": math.factorial(n),
            "lengths": "0,1,2,3,h,h+1,h+2,h+4", "ok": True})
    results["minimal_endpoint_checks"] = []
    for n in range(1, 7):
        counts = minimal_cycle_counts(n)
        for endpoint in permutations(range(n)):
            h = sum(defect_type(endpoint))
            assert minimal_completion_count(endpoint, counts) == BridgeDP(n, h, endpoint).count
            assert evaluate(n, sample_minimal(endpoint, random.Random(20260905))) == endpoint
        results["minimal_endpoint_checks"].append({"N": n, "all_endpoints": math.factorial(n),
            "single_cycle_counts": counts[1:], "counts_and_sampler_valid": True})
    # Force every nontrivial random-integer rejection to fail: bounded sampler
    # must still return the requested endpoint, not an error or invalid word.
    class RejectingBits:
        @staticmethod
        def getrandbits(k):
            return (1 << k) - 1
    for endpoint in [identity(3), (1, 2, 0)]:
        dp = BridgeDP(3, 4, endpoint)
        assert evaluate(3, dp.sample(RejectingBits(), accuracy_bits=8)) == endpoint
    results["forced_rejection_fallback"] = "valid endpoints"
    return results


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--output", type=Path, required=True)
    args = parser.parse_args()
    start = time.perf_counter()
    results = exact_checks()
    results["elapsed_seconds"] = time.perf_counter() - start
    args.output.write_text(json.dumps(results, indent=2) + "\n")
    print(json.dumps({"status": "passed", "output": str(args.output),
                      "elapsed_seconds": results["elapsed_seconds"]}))


if __name__ == "__main__":
    main()

