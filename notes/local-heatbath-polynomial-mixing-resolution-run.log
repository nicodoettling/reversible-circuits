    def widest_paths(source: Macro):
        upper = Fraction(raw_count + 1)
        best: dict[Macro, Fraction] = {source: upper}
        parent: dict[Macro, Macro | None] = {source: None}
        heap: list[tuple[Fraction, Macro]] = [(-upper, source)]
        while heap:
