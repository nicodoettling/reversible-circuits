                worst = row
            count += 1
        record = {
            "s": s,
            "scanned_context_count": count,
            "memoized_context_count": solver.contexts_evaluated,
            "worst": worst,
        }
        records.append(record)
        print(json.dumps(record, sort_keys=True), flush=True)

    result = {
        "claim_tested": (
