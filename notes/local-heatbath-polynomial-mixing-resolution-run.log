            "cycle-15/mission-M71-marked-weighted-green-contraction/"
            f"marked_resolvent_probe.py --s-max {args.s_max} "
            f"--K-max {args.K_max} --rtol {args.rtol} "
            f"--maxiter {args.maxiter} --output {args.output}"
        ),
        "parameters": {
