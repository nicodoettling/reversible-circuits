#!/usr/bin/env python3
"""Exact hidden-atom canonical-basin frame spectrum for M123.

For each active canonical endpoint e at local rank s, let B_e be the source
composition basin, c_e = degree(e) rho(e), and define on the root-composition
atom space L2(rho)

    v_e(C) = 1[C in B_e] sqrt(rho(C)/c_e).

Then ``<f,v_e> = sum_(C in B_e) rho(C) f(C)/sqrt(c_e)`` and the local reset
energy is the sum of squared analysis coordinates.  Pulling the vectors back
to the finer marked word/scan/outcome space does not change their nonzero
Gram spectrum: within each composition block the pullback is constant and
the deletion/insertion map is measure-preserving in the inherited initial
normalization.  Thus an eigenvalue of the exact rational Gram matrix above
one refutes a Bessel bound on the hidden marked atom space as well.

This script finds exact characteristic polynomials and uses exact Sturm
sequences to isolate the largest eigenvalue.  No floating eigenvalue is used
for a promoted sign.
"""

from __future__ import annotations

import argparse
import functools
import hashlib
import json
import math
import platform
import subprocess
from fractions import Fraction as F
from pathlib import Path


Composition = tuple[int, ...]
Polynomial = tuple[F, ...]  # ascending powers


def record(value: F) -> dict[str, str | float]:
    return {
        "numerator": str(value.numerator),
        "denominator": str(value.denominator),
        "decimal": float(value),
    }


def git_commit() -> str:
    try:
        return subprocess.check_output(["git", "rev-parse", "HEAD"], text=True).strip()
    except (OSError, subprocess.CalledProcessError):
        return "unavailable"


@functools.cache
def weight(n: int) -> F:
    return F(n ** (n - 1), math.factorial(n))


@functools.cache
def compositions(n: int) -> tuple[Composition, ...]:
    if n == 0:
        return ((),)
    return tuple(
        (first,) + tail
        for first in range(1, n + 1)
        for tail in compositions(n - first)
    )


def rho(parts: Composition) -> F:
    return math.prod(weight(a) for a in parts) / (
        math.factorial(len(parts)) * weight(sum(parts) + 1)
    )


def active(endpoint: Composition) -> bool:
    return len(endpoint) >= 2 and endpoint[0] + endpoint[1] - 1 >= 2


def in_basin(source: Composition, endpoint: Composition) -> bool:
    A, tail = endpoint[0], endpoint[1:]
    return any(
        sum(source[:cut]) == A and source[cut:] == tail
        for cut in range(1, len(source) + 1)
    )


def trim(poly: list[F] | tuple[F, ...]) -> Polynomial:
    values = list(poly)
    while values and values[-1] == 0:
        values.pop()
    return tuple(values)


def psub(left: Polynomial, right: Polynomial) -> Polynomial:
    out = [F(0)] * max(len(left), len(right))
    for i, value in enumerate(left):
        out[i] += value
    for i, value in enumerate(right):
        out[i] -= value
    return trim(out)


def pmul(left: Polynomial, right: Polynomial) -> Polynomial:
    if not left or not right:
        return ()
    out = [F(0)] * (len(left) + len(right) - 1)
    for i, a in enumerate(left):
        for j, b in enumerate(right):
            out[i + j] += a * b
    return trim(out)


def pdivmod(numerator: Polynomial, denominator: Polynomial):
    if not denominator:
        raise ZeroDivisionError
    rem = list(numerator)
    quotient = [F(0)] * max(1, len(numerator) - len(denominator) + 1)
    while len(trim(rem)) >= len(denominator):
        rem = list(trim(rem))
        degree = len(rem) - len(denominator)
        coefficient = rem[-1] / denominator[-1]
        quotient[degree] += coefficient
        for i, value in enumerate(denominator):
            rem[degree + i] -= coefficient * value
    return trim(quotient), trim(rem)


def peval(poly: Polynomial, x: F) -> F:
    value = F(0)
    for coefficient in reversed(poly):
        value = value * x + coefficient
    return value


def determinant(matrix: tuple[tuple[Polynomial, ...], ...]) -> Polynomial:
    n = len(matrix)
    if n == 0:
        return (F(1),)
    if n == 1:
        return matrix[0][0]
    answer: Polynomial = ()
    for column in range(n):
        minor = tuple(
            tuple(row[j] for j in range(n) if j != column)
            for row in matrix[1:]
        )
        term = pmul(matrix[0][column], determinant(minor))
        answer = psub(answer, term) if column % 2 else padd(answer, term)
        answer = trim(answer)
    return answer


def padd(left: Polynomial, right: Polynomial) -> Polynomial:
    n = max(len(left), len(right))
    return trim([
        (left[i] if i < len(left) else F(0))
        + (right[i] if i < len(right) else F(0))
        for i in range(n)
    ])


def charpoly(matrix: tuple[tuple[F, ...], ...]) -> Polynomial:
    n = len(matrix)
    symbolic = []
    for i in range(n):
        row = []
        for j in range(n):
            # det(lambda I - G)
            row.append((-matrix[i][j], F(1)) if i == j else (-matrix[i][j],))
        symbolic.append(tuple(row))
    return determinant(tuple(symbolic))


def derivative(poly: Polynomial) -> Polynomial:
    return trim([F(i) * poly[i] for i in range(1, len(poly))])


def sturm_sequence(poly: Polynomial) -> tuple[Polynomial, ...]:
    seq = [trim(poly), derivative(poly)]
    while seq[-1]:
        _, remainder = pdivmod(seq[-2], seq[-1])
        if not remainder:
            break
        seq.append(tuple(-value for value in remainder))
    return tuple(seq)


def sign_changes(sequence: tuple[Polynomial, ...], x: F) -> int:
    signs = []
    for poly in sequence:
        value = peval(poly, x)
        if value:
            signs.append(1 if value > 0 else -1)
    return sum(signs[i] != signs[i - 1] for i in range(1, len(signs)))


def roots_between(sequence: tuple[Polynomial, ...], left: F, right: F) -> int:
    return sign_changes(sequence, left) - sign_changes(sequence, right)


def largest_root_interval(poly: Polynomial, denominator_power: int = 32):
    seq = sturm_sequence(poly)
    upper = F(1)
    while roots_between(seq, F(0), upper) < len(poly) - 1:
        upper *= 2
    lower = F(0)
    # Isolate the last root by retaining exactly one root in (mid, upper].
    for _ in range(denominator_power):
        mid = (lower + upper) / 2
        if roots_between(seq, mid, upper) >= 1:
            lower = mid
        else:
            upper = mid
    return lower, upper, seq


def frame(s: int):
    atoms = compositions(s)
    endpoints = tuple(row for row in atoms if active(row))
    masses = {row: rho(row) for row in atoms}
    capacities = {row: len(row) * masses[row] for row in endpoints}
    gram = []
    for left in endpoints:
        row = []
        for right in endpoints:
            overlap = sum(
                (
                    masses[source]
                    for source in atoms
                    if in_basin(source, left) and in_basin(source, right)
                ),
                F(0),
            )
            # Avoid square roots by using the similar rational matrix
            # M_(e,f)=overlap(e,f)/capacity(e).  It has the same spectrum as
            # the symmetric Gram matrix C^{-1/2} O C^{-1/2}.
            row.append(overlap / capacities[left])
        gram.append(tuple(row))
    rational_similar = tuple(gram)
    polynomial = charpoly(rational_similar)
    lower, upper, sequence = largest_root_interval(polynomial)
    p_one = peval(polynomial, F(1))
    roots_above_one = roots_between(sequence, F(1), upper + 1)
    return {
        "s": s,
        "atom_count": len(atoms),
        "active_coordinate_count": len(endpoints),
        "endpoints": [list(row) for row in endpoints],
        "capacities": [record(capacities[row]) for row in endpoints],
        "rational_similar_gram": [[record(value) for value in row] for row in rational_similar],
        "characteristic_polynomial_ascending": [record(value) for value in polynomial],
        "characteristic_at_one": record(p_one),
        "root_count_above_one": roots_above_one,
        "largest_eigenvalue_interval": {
            "lower": record(lower),
            "upper": record(upper),
        },
        "frame_bound_le_one": upper <= 1,
        "frame_bound_gt_one": lower > 1,
    }


def main() -> None:
    parser = argparse.ArgumentParser()
    parser.add_argument("--s-max", type=int, default=5)
    parser.add_argument("--output", type=Path, required=True)
    args = parser.parse_args()
    if not 2 <= args.s_max <= 5:
        raise SystemExit("exact determinant audit is intentionally bounded to 2<=s<=5")
    rows = [frame(s) for s in range(2, args.s_max + 1)]
    payload = {
        "claim_tested": (
            "the union of hidden marked canonical-reset coordinate vectors has frame operator <= I"
        ),
        "status_rule": (
            "one exact largest-eigenvalue interval strictly above one refutes the universal Bessel/frame route"
        ),
        "hidden_pullback_note": (
            "measure-preserving deletion/insertion pullback preserves the nonzero Gram spectrum; "
            "constant composition blocks are therefore an exact spectral quotient, not a coarse upper bound"
        ),
        "convention": "(pq)(x)=p(q(x)); factors displayed left-to-right",
        "repository_commit": git_commit(),
        "python": platform.python_version(),
        "seed": None,
        "arithmetic": "fractions.Fraction characteristic polynomials and Sturm sequences",
        "parameters": {"s_max": args.s_max},
        "rows": rows,
        "first_failure": next((row for row in rows if row["frame_bound_gt_one"]), None),
    }
    encoded = json.dumps(payload, indent=2, sort_keys=True) + "\n"
    args.output.write_text(encoded)
    print(json.dumps({"output": str(args.output), "sha256": hashlib.sha256(encoded.encode()).hexdigest(), "first_failure": payload["first_failure"]}, sort_keys=True))


if __name__ == "__main__":
    main()


