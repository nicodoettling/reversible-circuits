+                "A_C": maxima["C"],
+                "A_D": maxima["D"],
+                "margin_C": 1.0 - 2.0 * maxima["C"]["cost"],
+                "margin_D": x - 2.0 * maxima["D"]["cost"],
+            }
+        )
+
+    return {
+        "N": n,
+        "M": len(edges),
+        "case_counts": {q: len(cases[q]) for q in cases},
+        "grid": grid_rows,
+    }
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--output", default="results.json")
+    parser.add_argument("--n-min", type=int, default=3)
+    parser.add_argument("--n-max", type=int, default=9)
+    args = parser.parse_args()
+
+    # A logarithmic/rationally recognizable grid; follow-up proof extracts
+    # explicit witnesses rather than treating this scan as universal.
+    grid = [
+        0.05,
+        0.1,
+        0.2,
+        1 / 3,
+        0.5,
+        2 / 3,
+        0.8,
+        1.0,
+        1.25,
