+        row = [0.0] * (nl * nr)
+        for j in range(nr):
+            row[i * nr + j] = 1.0
+        aeq.append(row)
+        beq.append(1.0 / nl)
+    for j in range(nr):
+        row = [0.0] * (nl * nr)
+        for i in range(nl):
+            row[i * nr + j] = 1.0
+        aeq.append(row)
+        beq.append(1.0 / nr)
