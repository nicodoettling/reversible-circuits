p=pathlib.Path('experiments/20260811-polynomial-mixing-resolution/cycle-17/mission-M79-m76-referee-resolvent/grouped_resolvent_attack.py').resolve(); s=importlib.util.spec_from_file_location('g',p); m=importlib.util.module_from_spec(s);s.loader.exec_module(m);g=m.GroupedResolvent(14)
for kind in ['K','K1','omqK']:
