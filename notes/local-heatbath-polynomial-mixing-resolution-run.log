(1,1,2,B), (1,2,1,B), (2,1,1,B)             1/125 each         4e
(1,1,1,1,B)                                 1/625              5f

(3,s-3)                                     18/(125x)          x(1-d)
(1,2,s-3), (2,1,s-3)                        4/(125x) each      x(1-e)
(1,1,1,s-3)                                 1/(125x)           x(1-f)

