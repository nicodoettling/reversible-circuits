+def audit_n(n: int, grid: list[float]) -> dict:
+    edges = list(combinations(range(n), 2))
+    perms = {edge: transposition_perm(n, edge) for edge in edges}
+    cases: dict[str, list[dict]] = {"C": [], "D": []}
+
+    for t in edges:
+        for tp in edges:
+            q = edge_type(t, tp)
+            if q == "E":
+                continue
+            for p in edges:
+                h = compose(perms[p], perms[t])
+                hp = compose(perms[p], perms[tp])
+                left = midpoint_fiber(h, edges, perms)
+                right = midpoint_fiber(hp, edges, perms)
+                cases[q].append({"p": p, "t": t, "tp": tp, "left": left, "right": right})
+
+    grid_rows = []
+    for x in grid:
+        maxima = {}
+        for q in ("C", "D"):
+            best_cost = -1.0
+            best_case = None
+            best_plan = None
