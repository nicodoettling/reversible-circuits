+        "scipy": scipy.__version__,
+        "numpy": np.__version__,
+        "convention": "compose(p,q)=p after q",
+        "runs": [audit_n(n, grid) for n in range(args.n_min, args.n_max + 1)],
+    }
+    with open(args.output, "w", encoding="utf-8") as handle:
