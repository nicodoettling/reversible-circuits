            "base_SS": text(base_ss),
            "base_SN": text(base_sn),
            "strictly_negative": True,
            "floating_value": -(float(base_ss) ** 1.5 + float(base_sn) ** 1.5),
        },
        "asymptotic": "F(delta)=-C delta^(-3/2)+O(1), C>0",
        "integrability": "integral_0^epsilon F(delta) ddelta diverges to -infinity",
        "convention": "(pq)(x)=p(q(x)); factors multiply left-to-right",
        "deterministic": True,
        "seed": None,
