#!/usr/bin/env python3
"""Finite binary64 discovery scan for M90's weighted reset resolvent.

This imports the frozen M79 grouped Cayley implementation only to select
candidates for independent exact certification.  Values below one are not
proof; values above one are not promoted until reproduced exactly.
"""

from __future__ import annotations

import argparse
import functools
import hashlib
import importlib.util
import json
import platform
import time
from pathlib import Path


def load_m79():
    source = Path(__file__).resolve().parents[2] / (
        "cycle-17/mission-M79-m76-referee-resolvent/"
        "grouped_resolvent_attack.py"
    )
    spec = importlib.util.spec_from_file_location("m79_grouped", source)
    if spec is None or spec.loader is None:
        raise RuntimeError(source)
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


M79 = load_m79()


class WeightedScanner:
    def __init__(self, s_max: int):
        self.core = M79.GroupedResolvent(s_max)
        self.contexts = 0

    @functools.lru_cache(maxsize=None)
    def g(
        self, s: int, K: int | None, R: int | None, B: int
    ) -> float:
        """Return ``q_x [(I-D)^-1 J_can W](x)``."""
        if s <= 1:
            return 0.0
        self.contexts += 1
        answer = 0.0
        for child, inverse_q_weight in self.core.jhat(
            s, K, R, B
        ):
            q_child = self.core.q(child[0], child[3])
            # M79 stores energy/q_child.  Undo that transform and apply
            # W(child)=1-q_child (every reset target is right-heavy).
            answer += inverse_q_weight * q_child * (1.0 - q_child)
        for k, t, mass in self.core.groups(s):
            if t <= B or t - 1 < 2:
                continue
            if K is None:
                answer += mass * self.g(t - 1, None, None, B)
            else:
                assert R is not None
                for j in range(1, k + 1):
                    coefficient = self.core.nu(K, R, k, j)
                    if coefficient:
                        answer += mass * coefficient * self.g(
                            t - 1, K + k, R + j, B
                        )
        return answer

    def row(self, s: int, K: int | None, B: int) -> dict[str, object]:
        q = self.core.q(s, B)
        R = None if K is None else K - 1
        g = self.g(s, K, R, B)
        ratio = g / (q * (1.0 - q))
        return {
            "s": s,
            "K": "infinity" if K is None else K,
            "R": "infinity-1" if R is None else R,
            "B": B,
            "q": q,
            "transformed_value": g,
            "ratio": ratio,
        }


def scan(s_values: list[int], K_values: list[int], include_infinite: bool) -> dict:
    scanner = WeightedScanner(max(s_values))
    rows = []
    overall = None
    contexts: list[int | None] = list(K_values)
    if include_infinite:
        contexts.append(None)
    for s in s_values:
        worst = None
        for K in contexts:
            for B in range(1, s + 1):
                row = scanner.row(s, K, B)
                if worst is None or row["ratio"] > worst["ratio"]:
                    worst = row
                if overall is None or row["ratio"] > overall["ratio"]:
                    overall = row
        rows.append(worst)
        print(json.dumps(worst, sort_keys=True), flush=True)
    return {
        "rank_worst_rows": rows,
        "overall_worst": overall,
        "memoized_weighted_contexts": scanner.contexts,
        "core_diagnostics": {
            "max_group_mass_error": scanner.core.max_group_mass_error,
            "max_contextual_mean_error": scanner.core.max_mean_error,
            "max_negative_roundoff": scanner.core.max_negative_roundoff,
        },
    }


def main() -> None:
    parser = argparse.ArgumentParser()
    parser.add_argument("--s-values", type=int, nargs="+", required=True)
    parser.add_argument("--K-values", type=int, nargs="*", default=[1, 2, 4, 16, 256])
    parser.add_argument("--no-infinite", action="store_true")
    parser.add_argument("--output", type=Path, required=True)
    args = parser.parse_args()
    started = time.time()
    result = scan(args.s_values, args.K_values, not args.no_infinite)
    payload = {
        "claim_tested": "right-heavy K_reset W <= W",
        "status_rule": (
            "binary64 is discovery only; any candidate violation requires "
            "independent exact certification; survival proves no theorem"
        ),
        "normalization": (
            "g=q*(I-D)^-1*J_can*W; Dhat=rho*K/(K+k); "
            "reset term=(theta^2/Q)*(1-q_child)"
        ),
        "arithmetic": "IEEE-754 binary64 grouped Cayley coefficients",
        "convention": "(pq)(x)=p(q(x)); factors left-to-right",
        "python": platform.python_version(),
        "seed": None,
        "parameters": {
            "s_values": args.s_values,
            "K_values": args.K_values,
            "include_infinite": not args.no_infinite,
        },
        "elapsed_seconds": time.time() - started,
        "result": result,
    }
    encoded = json.dumps(payload, indent=2, sort_keys=True) + "\n"
    args.output.write_text(encoded)
    print(json.dumps({
        "output": str(args.output),
        "sha256": hashlib.sha256(encoded.encode()).hexdigest(),
        "elapsed_seconds": payload["elapsed_seconds"],
        "overall_worst": result["overall_worst"],
    }, sort_keys=True))


if __name__ == "__main__":
    main()
#!/usr/bin/env python3
"""Exact second-moment recursion for contextual suffix observables.

M65's pointwise inheritance closes not only first moments but mixed second
moments.  For two attachment contexts ``a=(K,R)`` and ``b=(L,S)`` at the
same local rank and suffix size, condition on root part count ``k`` and last
part ``t``.  At ``t=B`` both observables are constant.  At ``t>B`` expand
both exact negative-hypergeometric mixtures on the same child macro.  This
gives an exact rank-descending recursion for ``E[Phi_a Phi_b]``.

The script uses that recursion to falsify the proposed contextual-variance
supersolution beyond the ranks available to direct macro enumeration.  A
finite pass remains non-theorem evidence.
"""

from __future__ import annotations

import argparse
import functools
import hashlib
import json
import platform
import time
from fractions import Fraction
from pathlib import Path

import exact_weighted_resolvent as EXACT


def ordered_pair(K: int, R: int, L: int, S: int) -> tuple[int, int, int, int]:
    if (L, S) < (K, R):
        return L, S, K, R
    return K, R, L, S


class SecondMoment:
    def __init__(self) -> None:
        self.calls = 0
        self.pair_terms = 0

    def moment(
        self, s: int, K: int, R: int, L: int, S: int, B: int
    ) -> Fraction:
        K, R, L, S = ordered_pair(K, R, L, S)
        return self._moment(s, K, R, L, S, B)

    @functools.lru_cache(maxsize=None)
    def _moment(
        self, s: int, K: int, R: int, L: int, S: int, B: int
    ) -> Fraction:
        if s == 1:
            if B != 1:
                raise AssertionError((s, K, R, L, S, B))
            # The unique local macro has terminal statistic identically one.
            return Fraction(1)
        if s < 1:
            return Fraction(0)
        self.calls += 1
        answer = Fraction(0)
        parent_phase_a = s + K - R
        parent_phase_b = s + L - S
        for k, t, mass in EXACT.groups(s):
            if t < B:
                continue
            if t == B:
                left = EXACT.contextual_value(k, t, K, R, B)
                right = EXACT.contextual_value(k, t, L, S, B)
                answer += mass * left * right
                continue
            if t - 1 < 1:
                continue
            for j in range(1, k + 1):
                left_probability = EXACT.nu(K, R, k, j)
                if not left_probability:
                    continue
                left_child = (t - 1, K + k, R + j)
                if left_child[0] + left_child[1] - left_child[2] >= parent_phase_a:
                    raise AssertionError(("left phase", s, K, R, k, t, j))
                for ell in range(1, k + 1):
                    right_probability = EXACT.nu(L, S, k, ell)
                    if not right_probability:
                        continue
                    right_child = (t - 1, L + k, S + ell)
                    if (
                        right_child[0] + right_child[1] - right_child[2]
                        >= parent_phase_b
                    ):
                        raise AssertionError(("right phase", s, L, S, k, t, ell))
                    self.pair_terms += 1
                    answer += (
                        mass
                        * left_probability
                        * right_probability
                        * self.moment(
                            t - 1,
                            left_child[1],
                            left_child[2],
                            right_child[1],
                            right_child[2],
                            B,
                        )
                    )
        return answer

    @functools.lru_cache(maxsize=None)
    def variance(self, s: int, K: int, R: int, B: int) -> Fraction:
        q = EXACT.q_split(s, B)
        return self.moment(s, K, R, K, R, B) - q * q


def fraction_record(value: Fraction) -> dict[str, object]:
    return {
        "decimal": float(value),
        "numerator": str(value.numerator),
        "denominator": str(value.denominator),
    }


def scan(s_max: int, k_max: int) -> dict[str, object]:
    moments = SecondMoment()
    resolvent = EXACT.ExactResolvent()
    failures = {
        "mean_or_variance_sanity": [],
        "one_step_variance_supersolution": [],
        "resolvent_over_variance": [],
        "beta_binomial_variance_envelope": [],
    }
    maxima: dict[str, tuple[Fraction, dict[str, object]] | None] = {
        "one_step_over_variance": None,
        "resolvent_over_variance": None,
        "variance_over_envelope": None,
    }
    contexts = 0

    def update(name: str, ratio: Fraction, row: dict[str, object]) -> None:
        current = maxima[name]
        if current is None or ratio > current[0]:
            maxima[name] = (ratio, row)

    for s in range(2, s_max + 1):
        for K in range(1, k_max + 1):
            for R in range(K):
                if R == 0 and K > 1:
                    continue
                for B in range(1, s + 1):
                    contexts += 1
                    x = (s, K, R, B)
                    q = EXACT.q_split(s, B)
                    variance = moments.variance(*x)
                    reset = EXACT.reset_budget(*x)
                    continuation = Fraction(0)
                    for k, t, mass in EXACT.groups(s):
                        if t <= B or t - 1 < 2:
                            continue
                        for j in range(1, k + 1):
                            probability = EXACT.nu(K, R, k, j)
                            if probability:
                                continuation += mass * probability * moments.variance(
                                    t - 1, K + k, R + j, B
                                )
                    one_step = reset + continuation
                    g = resolvent.g(*x)
                    envelope = q * (1 - q) * Fraction(K, R + 1)
                    row = {
                        "context": list(x),
                        "q": fraction_record(q),
                        "variance": fraction_record(variance),
                        "reset_budget": fraction_record(reset),
                        "continuation_variance_budget": fraction_record(continuation),
                        "one_step_total": fraction_record(one_step),
                        "one_step_margin": fraction_record(variance - one_step),
                        "transformed_resolvent": fraction_record(g),
                        "beta_binomial_envelope": fraction_record(envelope),
                    }
                    if variance < 0 or variance > envelope * 4:
                        failures["mean_or_variance_sanity"].append(row)
                    if variance:
                        update("one_step_over_variance", one_step / variance, row)
                        update("resolvent_over_variance", g / variance, row)
                    if envelope:
                        update("variance_over_envelope", variance / envelope, row)
                    if one_step > variance:
                        failures["one_step_variance_supersolution"].append(row)
                    if g > variance:
                        failures["resolvent_over_variance"].append(row)
                    if variance > envelope:
                        failures["beta_binomial_variance_envelope"].append(row)

    # Independent exact direct-macro calibration values from the M90 audit.
    calibrations = [
        ((5, 2, 1, 2), Fraction(10981, 131220)),
        ((6, 1, 0, 3), Fraction(24731355, 282475249)),
    ]
    calibration_rows = []
    for context, expected in calibrations:
        observed = moments.variance(*context)
        calibration_rows.append({
            "context": list(context),
            "expected": fraction_record(expected),
            "observed": fraction_record(observed),
            "exact_match": observed == expected,
        })
        if observed != expected:
            failures["mean_or_variance_sanity"].append(calibration_rows[-1])

    return {
